# Copy to .env.development (npm run dev) or .env.production (npm run start:prod).
PORT=8765
# Folder with the videos (symlinks are fine); relative paths are from server/.
# Scan results are saved under <MEDIA_FOLDER>/scans/.
MEDIA_FOLDER=../media
# Sightings, your tags and clocks (SQLite). Default: <MEDIA_FOLDER>/bibwatch.sqlite, so it travels with the videos.
# DATABASE_SQLITE_FILE=../media/bibwatch.sqlite
